{
  "name": "searchgal-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "SearchGal 桌面伙伴",
  "author": "SearchGal contributors",
  "license": "AGPL-3.0-only",
  "main": "out/main/index.cjs",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "pack": "npm run build && electron-builder --dir",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "8.2.2"
  },
  "build": {
    "appId": "io.searchgal.desktop",
    "productName": "SearchGal",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "SearchGal-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": { "target": "dir", "category": "public.app-category.utilities" }
  }
}
